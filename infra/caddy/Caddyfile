{
	order coraza_waf first
	order rate_limit before reverse_proxy
}

# Public surface. The key includes the Host header so the limit is per tenant
# once the host is the clinic (FR-1.1.7). Cloudflare is not in this path.
:80 {
	rate_limit {
		zone public_surface {
			key {remote_host}.{http.request.host}
			events 120
			window 1m
		}
	}

	coraza_waf {
		load_owasp_crs
		directives `
			Include @coraza.conf-recommended
			Include @crs-setup.conf.example
			Include @owasp_crs/*.conf
			SecRuleEngine On
		`
	}

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:3000
	}

	handle {
		root * /srv/web
		file_server
	}
}
